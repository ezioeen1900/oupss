#!/usr/bin/env bash
export LANG=zh_CN.UTF-8
export LANGUAGE=zh_CN:zh
export LC_ALL=zh_CN.UTF-8

if /usr/sbin/ss -ltn 2>/dev/null | grep -q '127.0.0.1:7897'; then
    PROXY_ARGS=(--proxy-server=http://127.0.0.1:7897 --proxy-bypass-list='localhost;127.0.0.1;::1;192.168.0.0/16;10.0.0.0/8')
else
    PROXY_ARGS=(--no-proxy-server)
fi

exec /usr/bin/chromium --lang=zh-CN "${PROXY_ARGS[@]}" "$@"
