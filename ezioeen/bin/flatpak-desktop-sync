#!/usr/bin/env bash
# 把 Flatpak 导出的桌面项同步到用户目录，确保 wofi 能搜到
src=/var/lib/flatpak/exports/share/applications
dst="$HOME/.local/share/applications"
[ -d "$src" ] || exit 0
mkdir -p "$dst"
for f in "$src"/*.desktop; do
    [ -e "$f" ] || continue
    base=$(basename "$f")
    [ -e "$dst/$base" ] || cp "$f" "$dst/$base"
done
